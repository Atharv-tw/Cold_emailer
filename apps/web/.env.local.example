# Copy to .env.local. Gitignored.

# Same OAuth client as the API. The API verifies the ID token against this id,
# so a mismatch shows up as "could not verify Google ID token".
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Encrypts the Auth.js session JWT, which is where the API session token lives.
#   npx auth secret
AUTH_SECRET=

AUTH_URL=http://localhost:3000
# 127.0.0.1, not localhost - Node resolves localhost to ::1 first.
API_BASE_URL=http://127.0.0.1:8000

# "Contact us" / "Report an issue" mailto links in the logged-out footer.
NEXT_PUBLIC_SUPPORT_EMAIL=
