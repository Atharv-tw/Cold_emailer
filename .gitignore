# Secrets and credentials - never commit these
config.yaml
.env
env.ps1
*.pem
*.key

# Local state
*.db
*.db-wal
*.db-shm
run.log

# Contact lists are personal data - keep them out of version control.
# Deny every spreadsheet by default and allow the examples back in, rather than
# naming patterns: a file called alfonso.csv is just as personal as leads.csv.
*.csv
*.xlsx
*.xls
!contacts.example.csv

# Web app
node_modules/
.next/
.env.local
next-env.d.ts
*.tsbuildinfo

# Uploaded resumes and other local object storage. Personal data - the same
# reason contact lists are excluded above.
var/

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
.pytest_cache/
*.egg-info/

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db


secrets.md
