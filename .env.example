# Copy to .env and fill in. .env is gitignored; this file must never hold a
# real secret, because it is committed.

ENVIRONMENT=development
DEBUG=false

DATABASE_URL=postgresql+psycopg://outreach:outreach@localhost:5432/outreach
REDIS_URL=redis://localhost:6379/0

WEB_ORIGIN=http://localhost:3000
API_BASE_URL=http://localhost:8000

# Google Cloud console > APIs & Services > Credentials > OAuth client (Web).
# Consent screen stays in "testing" mode: up to 100 users, no CASA review, and
# gmail.readonly works from day one. Users see an "unverified app" warning -
# that is expected, and onboarding should say so before they hit it.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Signs our own session cookies. Any long random string.
#   python -c "import secrets;print(secrets.token_urlsafe(48))"
SESSION_SECRET=

# Wraps the per-record data keys that encrypt Google refresh tokens.
# Exactly 32 raw bytes, base64-encoded:
#   python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
MASTER_KEY=

# Keys the cross-user recipient guard. Keep this OUT of the database's own
# secret store: the guard's privacy property depends on the table being
# useless to whoever holds it without this value.
#   python -c "import secrets;print(secrets.token_urlsafe(48))"
RECIPIENT_GUARD_SECRET=

# https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

STORAGE_DIR=./var/storage
