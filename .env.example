# Copy to .env and fill in. .env is gitignored; this file must never hold a
# real secret, because it is committed.

ENVIRONMENT=development
DEBUG=false

# The app connects as a non-superuser: superusers bypass row-level security
# outright, so connecting as the owner makes every policy a no-op.
DATABASE_URL=postgresql+psycopg://outreach_app:outreach_app@localhost:5432/outreach
# Migrations need the owner. Deliberately a different role - the application
# should not be able to drop the policies that constrain it.
MIGRATION_DATABASE_URL=postgresql+psycopg://outreach:outreach@localhost:5432/outreach
REDIS_URL=redis://localhost:6379/0

# Only for the self-hosted compose stack (infra/docker-compose.prod.yml); a
# managed Postgres ignores both. In compose the host names are the service
# names, so the two URLs above become ...@postgres:5432/... and ...@redis:6379.
#
# Bootstrap superuser for the Postgres container. Must match the password in
# MIGRATION_DATABASE_URL, since that is the role Alembic connects as.
POSTGRES_PASSWORD=
# Read by migration 0002 when it creates the outreach_app role, and must match
# the password in DATABASE_URL. Leave it unset and the role is created with the
# literal password "outreach_app" - fine on a laptop, not on a real deployment.
APP_DB_PASSWORD=

WEB_ORIGIN=http://localhost:3000
# 127.0.0.1, not localhost. Node resolves localhost to ::1 first and the API
# binds to IPv4, so "localhost" fails with ECONNREFUSED from the web app.
API_BASE_URL=http://127.0.0.1:8000

# Google Cloud console > APIs & Services > Credentials > OAuth client (Web).
# Consent screen stays in "testing" mode: up to 100 users, no CASA review, and
# gmail.readonly works from day one.
#
# Add every account that will sign in under OAuth consent screen > Audience >
# Test users. An account that is not on that list gets a flat
# "Error 403: access_denied" rather than the milder unverified-app warning.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Signs our own session cookies. Any long random string.
#   python -c "import secrets;print(secrets.token_urlsafe(48))"
SESSION_SECRET=

# Wraps the per-record data keys that encrypt Google refresh tokens.
# Exactly 32 raw bytes, base64-encoded:
#   python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
MASTER_KEY=

# Keys the cross-user recipient guard. Keep this OUT of the database's own
# secret store: the guard's privacy property depends on the table being
# useless to whoever holds it without this value.
#   python -c "import secrets;print(secrets.token_urlsafe(48))"
RECIPIENT_GUARD_SECRET=

# https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# https://quickemailverification.com/email-verification-api
# Free tier is 100 checks a day. Syntax and MX are checked first, so obvious
# typos never cost a credit. Leave it blank and addresses come back "unknown"
# rather than blocking anything - an unverified address is still sendable.
QUICKEMAILVERIFICATION_API_KEY=
# Point at .../v1/verify/sandbox to exercise the flow without spending credits.
QUICKEMAILVERIFICATION_ENDPOINT=https://api.quickemailverification.com/v1/verify

# Gmail push. Create a Pub/Sub topic, grant gmail-api-push@system.gserviceaccount.com
# the Publisher role on it, and point a push subscription at
#   <API_BASE_URL>/v1/gmail/push?token=<PUBSUB_VERIFICATION_TOKEN>
# Without the token the endpoint is an open POST that anyone could use to make
# this service hammer Gmail.
GMAIL_PUBSUB_TOPIC=
PUBSUB_VERIFICATION_TOKEN=

# Web push for follow-up reminders.
#   npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

STORAGE_DIR=./var/storage

# --------------------------------------------------------------- paid pool
#
# The contact pool is a paid tier, approved by hand: the user pays by UPI,
# uploads a screenshot, and an operator approves it in /admin. There is no
# payment gateway, so nothing here verifies that money moved.
#
# The first operator is made in SQL, because no endpoint can grant the role:
#   UPDATE users SET is_admin = true WHERE email = '...';

# Where payment claims are announced. The proof email is sent through the
# paying user's own Gmail grant - there is no platform mailbox.
ADMIN_NOTIFY_EMAIL=

# The purchase page builds a UPI QR from these in the browser, so the amount is
# never typed by hand into a payment app. Leave any of them unset and the page
# says "not available yet" rather than showing a QR that pays nobody.
UPI_ID=
UPI_PAYEE_NAME=
POOL_PRICE_INR=0

# Cloudflare R2 (S3-compatible) holds the payment screenshots. Use a PRIVATE
# bucket: a UPI receipt shows the payer's handle, phone number and bank, and
# every read here is a separately signed URL that expires in minutes.
# Deliberately not STORAGE_DIR, which is documented as disposable.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
